generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              user    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Account_userId_fkey")

  @@unique([provider, providerAccountId], map: "Account_provider_providerAccountId_key")
  @@index([userId], map: "Account_userId_fkey")
}

model auditlog {
  id         String   @id @default(cuid())
  user_id    String?
  action     String
  module     String
  ip_address String?
  user_agent String?  @db.Text
  details    Json?
  created_at DateTime @default(now())
  user       user?    @relation(fields: [user_id], references: [id], map: "AuditLog_user_id_fkey")

  @@index([module, created_at], map: "AuditLog_module_created_at_idx")
  @@index([user_id, created_at], map: "AuditLog_user_id_created_at_idx")
}

model notification {
  id             String              @id @default(cuid())
  dedupe_key     String              @unique(map: "Notification_dedupe_key_key") @db.VarChar(191)
  category       String
  priority       String              @default("INFO")
  title_en       String
  title_fa       String
  title_ps       String
  description_en String              @db.Text
  description_fa String              @db.Text
  description_ps String              @db.Text
  action_url     String?
  entity_type    String?
  entity_id      String?
  target_user_id String?
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt
  expires_at     DateTime?
  target_user    user?               @relation("notification_target_user", fields: [target_user_id], references: [id], onDelete: Cascade, map: "Notification_target_user_id_fkey")
  target_roles   notificationrole[]
  user_states    notificationstate[]

  @@index([priority, created_at], map: "Notification_priority_created_at_idx")
  @@index([target_user_id, created_at], map: "Notification_target_user_id_created_at_idx")
  @@index([entity_type, entity_id], map: "Notification_entity_type_entity_id_idx")
  @@index([expires_at], map: "Notification_expires_at_idx")
}

model notificationrole {
  id              String       @id @default(cuid())
  notification_id String
  role_id         String
  notification    notification @relation(fields: [notification_id], references: [id], onDelete: Cascade, map: "NotificationRole_notification_id_fkey")
  role            role         @relation(fields: [role_id], references: [id], onDelete: Cascade, map: "NotificationRole_role_id_fkey")

  @@unique([notification_id, role_id], map: "NotificationRole_notification_id_role_id_key")
  @@index([role_id], map: "NotificationRole_role_id_idx")
}

model notificationstate {
  id              String       @id @default(cuid())
  notification_id String
  user_id         String
  status          String       @default("READ")
  read_at         DateTime?
  dismissed_at    DateTime?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  notification    notification @relation(fields: [notification_id], references: [id], onDelete: Cascade, map: "NotificationState_notification_id_fkey")
  user            user         @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "NotificationState_user_id_fkey")

  @@unique([notification_id, user_id], map: "NotificationState_notification_id_user_id_key")
  @@index([user_id, status, updated_at], map: "NotificationState_user_id_status_updated_at_idx")
}

model contract {
  id                 String                 @id @default(cuid())
  client_id          String?
  vendor_id          String?
  lead_id            String?
  contract_number    String                 @unique(map: "Contract_contract_number_key")
  title              String
  status_id          String
  total_amount       Decimal                @db.Decimal(12, 2)
  contract_duration  String?
  contract_type_id   String
  template_id        String?
  content_html       String?                @db.Text
  country_id         String?
  percentage         Decimal?               @db.Decimal(5, 2)
  currency           String                 @default("USD")
  exchange_rate      Decimal                @db.Decimal(12, 4)
  level_id           String?
  signed_date        DateTime?
  start_date         DateTime
  end_date           DateTime
  auto_renew         Boolean                @default(false)
  renewal_status     String                 @default("ACTIVE")
  document_url       String?                @db.Text
  account_manager_id String?
  created_at         DateTime               @default(now())
  updated_at         DateTime               @updatedAt
  amount_base        Decimal                @default(0.00) @db.Decimal(14, 2)
  account_manager    hrmstaff?              @relation(fields: [account_manager_id], references: [id], map: "Contract_account_manager_id_fkey")
  client             crmclient?             @relation(fields: [client_id], references: [id], map: "Contract_client_id_fkey")
  vendor             contractvendor?        @relation(fields: [vendor_id], references: [id], map: "Contract_vendor_id_fkey")
  contract_type      option                 @relation("contract_contract_type_idTooption", fields: [contract_type_id], references: [id], map: "Contract_contract_type_id_fkey")
  template           option?                @relation("contract_template_idTooption", fields: [template_id], references: [id], map: "Contract_template_id_fkey")
  country            option?                @relation("contract_country_idTooption", fields: [country_id], references: [id], map: "Contract_country_id_fkey")
  lead               crmlead?               @relation(fields: [lead_id], references: [id], map: "Contract_lead_id_fkey")
  level              option?                @relation("contract_level_idTooption", fields: [level_id], references: [id], map: "Contract_level_id_fkey")
  status             option                 @relation("contract_status_idTooption", fields: [status_id], references: [id], map: "Contract_status_id_fkey")
  invoices           contractinvoice[]
  notifications      contractnotification[]
  incomes            financeincome[]
  projects           project[]

  @@index([account_manager_id], map: "Contract_account_manager_id_fkey")
  @@index([client_id, status_id], map: "Contract_client_id_status_id_idx")
  @@index([contract_type_id], map: "Contract_contract_type_id_fkey")
  @@index([country_id], map: "Contract_country_id_fkey")
  @@index([lead_id], map: "Contract_lead_id_fkey")
  @@index([level_id], map: "Contract_level_id_fkey")
  @@index([status_id], map: "Contract_status_id_fkey")
  @@index([template_id], map: "Contract_template_id_fkey")
  @@index([vendor_id], map: "Contract_vendor_id_fkey")
}

model contractvendor {
  id           String     @id @default(cuid())
  company_name String
  contact_name String
  email        String     @unique(map: "ContractVendor_email_key")
  phone        String?
  address      String?    @db.Text
  is_active    Boolean    @default(true)
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt
  contracts    contract[]

  @@index([company_name], map: "ContractVendor_company_name_idx")
}

model contractinvoice {
  id                String          @id @default(cuid())
  contract_id       String
  client_id         String
  invoice_number    String          @unique(map: "ContractInvoice_invoice_number_key")
  amount            Decimal         @db.Decimal(12, 2)
  due_date          DateTime
  status_id         String
  issued_date       DateTime        @default(now())
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  amount_base       Decimal         @default(0.00) @db.Decimal(14, 2)
  paid_amount       Decimal         @default(0.00) @db.Decimal(12, 2)
  remaining_balance Decimal         @default(0.00) @db.Decimal(12, 2)
  currency          String          @default("AFN")
  exchange_rate     Decimal         @db.Decimal(12, 4)
  client            crmclient       @relation(fields: [client_id], references: [id], map: "ContractInvoice_client_id_fkey")
  contract          contract        @relation(fields: [contract_id], references: [id], onDelete: Cascade, map: "ContractInvoice_contract_id_fkey")
  status            option          @relation(fields: [status_id], references: [id], map: "ContractInvoice_status_id_fkey")
  payment_incomes   financeincome[]

  @@index([client_id], map: "ContractInvoice_client_id_fkey")
  @@index([contract_id, status_id], map: "ContractInvoice_contract_id_status_id_idx")
  @@index([status_id], map: "ContractInvoice_status_id_fkey")
}

model contractnotification {
  id              String   @id @default(cuid())
  contract_id     String
  reminder_type   String
  sent_at         DateTime @default(now())
  recipient_email String
  status          String   @default("SENT")
  contract        contract @relation(fields: [contract_id], references: [id], onDelete: Cascade, map: "ContractNotification_contract_id_fkey")

  @@index([contract_id, reminder_type], map: "ContractNotification_contract_id_reminder_type_idx")
}

model crmactivity {
  id            String     @id @default(cuid())
  lead_id       String?
  client_id     String?
  staff_id      String
  activity_type String
  title         String
  description   String?    @db.Text
  activity_date DateTime   @default(now())
  due_date      DateTime?
  is_completed  Boolean    @default(false)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  client        crmclient? @relation(fields: [client_id], references: [id], onDelete: Cascade, map: "CrmActivity_client_id_fkey")
  lead          crmlead?   @relation(fields: [lead_id], references: [id], onDelete: Cascade, map: "CrmActivity_lead_id_fkey")
  staff         hrmstaff   @relation(fields: [staff_id], references: [id], map: "CrmActivity_staff_id_fkey")

  @@index([client_id, activity_date], map: "CrmActivity_client_id_activity_date_idx")
  @@index([lead_id, activity_date], map: "CrmActivity_lead_id_activity_date_idx")
  @@index([staff_id], map: "CrmActivity_staff_id_idx")
}

model crmclient {
  id                   String            @id @default(cuid())
  lead_id              String?           @unique(map: "CrmClient_lead_id_key")
  company_name         String
  primary_contact_name String
  email                String            @unique(map: "CrmClient_email_key")
  phone                String?
  address              String?           @db.Text
  tax_id               String?
  account_manager_id   String?
  status               String            @default("ACTIVE")
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  notes                String?           @db.Text
  contracts            contract[]
  invoices             contractinvoice[]
  activities           crmactivity[]
  account_manager      hrmstaff?         @relation(fields: [account_manager_id], references: [id], map: "CrmClient_account_manager_id_fkey")
  lead                 crmlead?          @relation(fields: [lead_id], references: [id], map: "CrmClient_lead_id_fkey")
  incomes              financeincome[]
  projects             project[]

  @@index([account_manager_id], map: "CrmClient_account_manager_id_fkey")
}

model crmlead {
  id                  String        @id @default(cuid())
  title               String
  company_name        String?
  contact_name        String
  email               String
  phone               String?
  source_id           String
  status_id           String
  assigned_to_id      String?
  estimated_value     Decimal?      @db.Decimal(12, 2)
  notes               String?       @db.Text
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt
  next_follow_up_date DateTime?
  amount_base         Decimal       @default(0.00) @db.Decimal(14, 2)
  currency            String        @default("AFN")
  exchange_rate       Decimal       @db.Decimal(12, 4)
  contracts           contract[]
  activities          crmactivity[]
  converted_client    crmclient?
  assigned_to         hrmstaff?     @relation(fields: [assigned_to_id], references: [id], map: "CrmLead_assigned_to_id_fkey")
  source              option        @relation("crmlead_source_idTooption", fields: [source_id], references: [id], map: "CrmLead_source_id_fkey")
  status              option        @relation("crmlead_status_idTooption", fields: [status_id], references: [id], map: "CrmLead_status_id_fkey")
  origin_visitor      crmvisitor?

  @@index([assigned_to_id], map: "CrmLead_assigned_to_id_fkey")
  @@index([source_id], map: "CrmLead_source_id_fkey")
  @@index([status_id, created_at], map: "CrmLead_status_id_created_at_idx")
}

model crmvisitor {
  id                String    @id @default(cuid())
  full_name         String
  email             String?
  phone             String
  company_name      String?
  purpose           String
  visited_at        DateTime  @default(now())
  notes             String?   @db.Text
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  check_out_time    DateTime?
  host_staff_id     String?
  status            String    @default("CHECKED_IN")
  converted_lead_id String?   @unique(map: "CrmVisitor_converted_lead_id_key")
  converted_lead    crmlead?  @relation(fields: [converted_lead_id], references: [id], map: "CrmVisitor_converted_lead_id_fkey")
  host_staff        hrmstaff? @relation(fields: [host_staff_id], references: [id], map: "CrmVisitor_host_staff_id_fkey")

  @@index([host_staff_id], map: "CrmVisitor_host_staff_id_idx")
  @@index([status, visited_at], map: "CrmVisitor_status_visited_at_idx")
  @@index([visited_at], map: "CrmVisitor_visited_at_idx")
}

model financeexpense {
  id                String              @id @default(cuid())
  voucher_number    String?             @unique(map: "FinanceExpense_voucher_number_key")
  payroll_salary_id String?             @unique(map: "FinanceExpense_payroll_salary_id_key")
  project_id        String?
  spent_by_id       String?
  approved_by_id    String?
  processed_by_id   String?
  payment_method_id String?
  vendor_payee      String              @default("Legacy Payee")
  approval_status   String              @default("PENDING_APPROVAL")
  approved_at       DateTime?
  paid_at           DateTime?
  rejection_reason  String?             @db.Text
  receipt_url       String?             @db.Text
  expense_date      DateTime            @db.Date
  details           String              @db.Text
  expense_type_id   String
  quantity          Int                 @default(1)
  unit_price        Decimal             @db.Decimal(12, 2)
  sub_total         Decimal             @db.Decimal(12, 2)
  exchange_rate     Decimal             @db.Decimal(12, 4)
  fx_snapshot_at    DateTime?
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  amount_base       Decimal             @default(0.00) @db.Decimal(14, 2)
  currency          String              @default("AFN")
  expense_type      option              @relation(fields: [expense_type_id], references: [id], map: "FinanceExpense_expense_type_id_fkey")
  payment_method    option?             @relation("financeexpense_payment_method_idTooption", fields: [payment_method_id], references: [id], map: "FinanceExpense_payment_method_id_fkey")
  project           project?            @relation(fields: [project_id], references: [id], map: "FinanceExpense_project_id_fkey")
  spent_by          hrmstaff?           @relation(fields: [spent_by_id], references: [id], map: "FinanceExpense_spent_by_id_fkey")
  approved_by       hrmstaff?           @relation("financeexpense_approved_by", fields: [approved_by_id], references: [id], onDelete: SetNull, map: "FinanceExpense_approved_by_id_fkey")
  processed_by      hrmstaff?           @relation("financeexpense_processed_by", fields: [processed_by_id], references: [id], onDelete: SetNull, map: "FinanceExpense_processed_by_id_fkey")
  payroll_salary    financesalary?      @relation(fields: [payroll_salary_id], references: [id], onDelete: Restrict, map: "FinanceExpense_payroll_salary_id_fkey")
  ledger_entry      generalledgerentry?

  @@index([created_at], map: "FinanceExpense_created_at_idx")
  @@index([expense_type_id], map: "FinanceExpense_expense_type_id_fkey")
  @@index([payment_method_id], map: "FinanceExpense_payment_method_id_fkey")
  @@index([project_id], map: "FinanceExpense_project_id_fkey")
  @@index([spent_by_id], map: "FinanceExpense_spent_by_id_fkey")
  @@index([approved_by_id], map: "FinanceExpense_approved_by_id_fkey")
  @@index([processed_by_id], map: "FinanceExpense_processed_by_id_fkey")
  @@index([approval_status], map: "FinanceExpense_approval_status_idx")
}

model generalledgerentry {
  id                   String         @id @default(cuid())
  expense_id           String         @unique(map: "GeneralLedgerEntry_expense_id_key")
  account_code         String
  entry_type           String         @default("DEBIT")
  transaction_amount   Decimal        @db.Decimal(12, 2)
  transaction_currency String
  exchange_rate        Decimal        @db.Decimal(12, 4)
  debit_base           Decimal        @db.Decimal(14, 2)
  credit_base          Decimal        @default(0.00) @db.Decimal(14, 2)
  entry_date           DateTime       @db.Date
  description          String         @db.Text
  posted_by_user_id    String?
  created_at           DateTime       @default(now())
  expense              financeexpense @relation(fields: [expense_id], references: [id], onDelete: Restrict, map: "GeneralLedgerEntry_expense_id_fkey")
  posted_by_user       user?          @relation(fields: [posted_by_user_id], references: [id], onDelete: SetNull, map: "GeneralLedgerEntry_posted_by_user_id_fkey")

  @@index([account_code, entry_date], map: "GeneralLedgerEntry_account_code_entry_date_idx")
  @@index([posted_by_user_id], map: "GeneralLedgerEntry_posted_by_user_id_fkey")
}

model financeincome {
  id                     String           @id @default(cuid())
  receipt_voucher_number String?          @unique(map: "FinanceIncome_receipt_voucher_number_key")
  invoice_id             String?
  payment_method_id      String?
  payment_date           DateTime?
  notes                  String?          @db.Text
  client_id              String?
  contract_id            String?
  project_id             String?
  received_by_id         String?
  status                 String           @default("PENDING")
  name                   String
  pay_details            String?          @db.Text
  income_type_id         String
  total_amount           Decimal          @db.Decimal(12, 2)
  paid_amount            Decimal          @default(0.00) @db.Decimal(12, 2)
  remind_amount          Decimal          @default(0.00) @db.Decimal(12, 2)
  exchange_rate          Decimal          @db.Decimal(12, 4)
  fx_snapshot_at         DateTime?
  remind_date            DateTime?
  created_at             DateTime         @default(now())
  updated_at             DateTime         @updatedAt
  amount_base            Decimal          @default(0.00) @db.Decimal(14, 2)
  currency               String           @default("AFN")
  client                 crmclient?       @relation(fields: [client_id], references: [id], map: "FinanceIncome_client_id_fkey")
  contract               contract?        @relation(fields: [contract_id], references: [id], map: "FinanceIncome_contract_id_fkey")
  income_type            option           @relation(fields: [income_type_id], references: [id], map: "FinanceIncome_income_type_id_fkey")
  project                project?         @relation(fields: [project_id], references: [id], map: "FinanceIncome_project_id_fkey")
  received_by            hrmstaff?        @relation(fields: [received_by_id], references: [id], map: "FinanceIncome_received_by_id_fkey")
  invoice                contractinvoice? @relation(fields: [invoice_id], references: [id], onDelete: SetNull, map: "FinanceIncome_invoice_id_fkey")
  payment_method         option?          @relation("financeincome_payment_method_idTooption", fields: [payment_method_id], references: [id], onDelete: SetNull, map: "FinanceIncome_payment_method_id_fkey")

  @@index([client_id], map: "FinanceIncome_client_id_fkey")
  @@index([contract_id], map: "FinanceIncome_contract_id_fkey")
  @@index([created_at], map: "FinanceIncome_created_at_idx")
  @@index([income_type_id], map: "FinanceIncome_income_type_id_fkey")
  @@index([invoice_id], map: "FinanceIncome_invoice_id_fkey")
  @@index([payment_method_id], map: "FinanceIncome_payment_method_id_fkey")
  @@index([project_id], map: "FinanceIncome_project_id_fkey")
  @@index([received_by_id], map: "FinanceIncome_received_by_id_fkey")
}

model financeloan {
  id                        String                  @id @default(cuid())
  staff_id                  String?
  loan_type                 String                  @default("STAFF")
  entity_name               String?
  lender_type               String?
  loan_number               String                  @unique(map: "FinanceLoan_loan_number_key")
  total_amount              Decimal                 @db.Decimal(12, 2)
  monthly_deduction         Decimal                 @db.Decimal(12, 2)
  repaid_amount             Decimal                 @default(0.00) @db.Decimal(12, 2)
  remaining_balance         Decimal                 @db.Decimal(12, 2)
  status_id                 String
  issue_date                DateTime                @db.Date
  repayment_start_date      DateTime?               @db.Date
  auto_deduct               Boolean                 @default(false)
  annual_interest_rate      Decimal                 @default(0.00) @db.Decimal(7, 4)
  tenure_months             Int?
  disbursement_bank_account String?
  reason                    String?                 @db.Text
  approved_by_id            String?
  created_at                DateTime                @default(now())
  updated_at                DateTime                @updatedAt
  amount_base               Decimal                 @default(0.00) @db.Decimal(14, 2)
  currency                  String                  @default("AFN")
  exchange_rate             Decimal                 @db.Decimal(12, 4)
  fx_snapshot_at            DateTime?
  approved_by               hrmstaff?               @relation("financeloan_approved_by_idTohrmstaff", fields: [approved_by_id], references: [id], map: "FinanceLoan_approved_by_id_fkey")
  staff                     hrmstaff?               @relation("financeloan_staff_idTohrmstaff", fields: [staff_id], references: [id], map: "FinanceLoan_staff_id_fkey")
  status                    option                  @relation(fields: [status_id], references: [id], map: "FinanceLoan_status_id_fkey")
  repayments                loanrepayment[]
  repayment_schedule        loanrepaymentschedule[]

  @@index([approved_by_id], map: "FinanceLoan_approved_by_id_fkey")
  @@index([staff_id], map: "FinanceLoan_staff_id_fkey")
  @@index([status_id], map: "FinanceLoan_status_id_fkey")
}

model loanrepaymentschedule {
  id                  String      @id @default(cuid())
  loan_id             String
  installment_number  Int
  due_date            DateTime    @db.Date
  opening_principal   Decimal     @db.Decimal(14, 2)
  principal_amount    Decimal     @db.Decimal(14, 2)
  interest_amount     Decimal     @db.Decimal(14, 2)
  payment_amount      Decimal     @db.Decimal(14, 2)
  remaining_principal Decimal     @db.Decimal(14, 2)
  status              String      @default("SCHEDULED")
  paid_at             DateTime?
  created_at          DateTime    @default(now())
  loan                financeloan @relation(fields: [loan_id], references: [id], onDelete: Cascade, map: "LoanRepaymentSchedule_loan_id_fkey")

  @@unique([loan_id, installment_number], map: "LoanRepaymentSchedule_loan_id_installment_key")
  @@index([due_date, status], map: "LoanRepaymentSchedule_due_date_status_idx")
}

model loanrepayment {
  id                 String      @id @default(cuid())
  loan_id            String
  amount             Decimal     @db.Decimal(12, 2)
  repayment_date     DateTime    @db.Date
  payment_method_id  String?
  source             String
  reference_id       String?
  currency           String
  exchange_rate      Decimal     @db.Decimal(12, 4)
  fx_snapshot_at     DateTime    @default(now())
  amount_base        Decimal     @db.Decimal(14, 2)
  created_by_user_id String?
  notes              String?     @db.Text
  created_at         DateTime    @default(now())
  loan               financeloan @relation(fields: [loan_id], references: [id], onDelete: Cascade, map: "LoanRepayment_loan_id_fkey")
  payment_method     option?     @relation(fields: [payment_method_id], references: [id], map: "LoanRepayment_payment_method_id_fkey")
  created_by_user    user?       @relation(fields: [created_by_user_id], references: [id], onDelete: SetNull, map: "LoanRepayment_created_by_user_id_fkey")

  @@unique([loan_id, source, reference_id], map: "LoanRepayment_loan_id_source_reference_id_key")
  @@index([loan_id, repayment_date], map: "LoanRepayment_loan_id_repayment_date_idx")
