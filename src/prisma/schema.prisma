  @@index([project_id, work_date], map: "TaskTimesheet_project_id_work_date_idx")
  @@index([staff_id, work_date], map: "TaskTimesheet_staff_id_work_date_idx")
  @@index([created_by_user_id], map: "TaskTimesheet_created_by_user_id_fkey")
}

model tasksubtask {
  id            String        @id @default(cuid())
  task_id       String
  parent_id     String?
  title         String
  is_completed  Boolean       @default(false)
  sort_order    Int           @default(0)
  created_by_id String?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  task          task          @relation(fields: [task_id], references: [id], onDelete: Cascade, map: "TaskSubtask_task_id_fkey")
  parent        tasksubtask?  @relation("TaskSubtaskTree", fields: [parent_id], references: [id], onDelete: Cascade, map: "TaskSubtask_parent_id_fkey")
  children      tasksubtask[] @relation("TaskSubtaskTree")
  created_by    hrmstaff?     @relation(fields: [created_by_id], references: [id], onDelete: SetNull, map: "TaskSubtask_created_by_id_fkey")

  @@index([task_id, sort_order], map: "TaskSubtask_task_id_sort_order_idx")
  @@index([parent_id], map: "TaskSubtask_parent_id_fkey")
  @@index([created_by_id], map: "TaskSubtask_created_by_id_fkey")
}

model taskattachment {
  id                 String   @id @default(cuid())
  task_id            String
  created_by_user_id String?
  attachment_type    String   @default("FILE")
  name               String
  url                String   @db.Text
  mime_type          String?
  file_size          Int?
  created_at         DateTime @default(now())
  task               task     @relation(fields: [task_id], references: [id], onDelete: Cascade, map: "TaskAttachment_task_id_fkey")
  created_by_user    user?    @relation(fields: [created_by_user_id], references: [id], onDelete: SetNull, map: "TaskAttachment_created_by_user_id_fkey")

  @@index([task_id, created_at], map: "TaskAttachment_task_id_created_at_idx")
  @@index([created_by_user_id], map: "TaskAttachment_created_by_user_id_fkey")
}

model taskcomment {
  id         String   @id @default(cuid())
  task_id    String
  author_id  String
  body       String   @db.Text
  created_at DateTime @default(now())
  task       task     @relation(fields: [task_id], references: [id], onDelete: Cascade, map: "TaskComment_task_id_fkey")
  author     hrmstaff @relation(fields: [author_id], references: [id], onDelete: Restrict, map: "TaskComment_author_id_fkey")

  @@index([task_id, created_at], map: "TaskComment_task_id_created_at_idx")
  @@index([author_id], map: "TaskComment_author_id_fkey")
}

model taskassignee {
  id          String   @id @default(cuid())
  task_id     String
  staff_id    String
  assigned_at DateTime @default(now())
  task        task     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  staff       hrmstaff @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  @@unique([task_id, staff_id])
  @@index([staff_id])
  @@index([task_id])
}

model user {
  id                      String               @id @default(cuid())
  name                    String?
  email                   String?              @unique(map: "User_email_key")
  emailVerified           DateTime?
  image                   String?
  password_hash           String?
  account_status          user_account_status  @default(ACTIVE)
  locale                  String               @default("en")
  last_login_at           DateTime?
  created_by_id           String?
  created_at              DateTime             @default(now())
  updated_at              DateTime             @updatedAt
  accounts                account[]
  audit_logs              auditlog[]
  staff                   hrmstaff?
  approved_leave_requests hrmstaffleave[]
  sessions                session[]
  inventory_movements     inventorymovement[]
  loan_repayments         loanrepayment[]
  task_timesheets         tasktimesheet[]
  task_attachments        taskattachment[]
  general_ledger_entries  generalledgerentry[]
  created_by              user?                @relation("userTouser", fields: [created_by_id], references: [id], map: "User_created_by_id_fkey")
  created_users           user[]               @relation("userTouser")
  roles                   role[]               @relation("userroles")
  targeted_notifications  notification[]       @relation("notification_target_user")
  notification_states     notificationstate[]

  @@index([created_by_id], map: "User_created_by_id_idx")
}

model VerificationToken {
  identifier String
  token      String   @unique(map: "VerificationToken_token_key")
  expires    DateTime

  @@unique([identifier, token], map: "VerificationToken_identifier_token_key")
  @@map("verificationtoken")
}

enum setup_scope {
  GLOBAL
}

enum user_account_status {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_ACTIVATION
}
