datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

// AUTHENTICATION & ROLES PERMISSION
enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_ACTIVATION
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id             String        @id @default(cuid())
  name           String?
  email          String?       @unique
  emailVerified  DateTime?
  image          String?
  password_hash  String?
  account_status AccountStatus @default(ACTIVE)
  locale         String        @default("en")
  last_login_at  DateTime?
  created_by_id  String?

  // NextAuth Relations
  accounts Account[]
  sessions Session[]

  // Self-Referencing Creator Relation
  created_by    User?  @relation("UserCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)
  created_users User[] @relation("UserCreatedBy")

  // ERP Core & RBAC Relations
  staff         HrmStaff?
  roles         Role[]       @relation("UserRoles")
  audit_logs    AuditLog[]
  hosted_visits CrmVisitor[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([created_by_id])
}

model Role {
  id           String   @id @default(cuid())
  name         String   @unique
  display_name String
  description  String?  @db.Text
  is_system    Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  users            User[]           @relation("UserRoles")
  role_permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  module      String
  description String?  @db.Text
  created_at  DateTime @default(now())

  role_permissions RolePermission[]
}

model RolePermission {
  id            String   @id @default(cuid())
  role_id       String
  permission_id String
  granted_at    DateTime @default(now())

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
}

model AuditLog {
  id         String   @id @default(cuid())
  user_id    String?
  action     String
  module     String
  ip_address String?
  user_agent String?  @db.Text
  details    Json?
  created_at DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at])
  @@index([module, created_at])
}

// HRM
model HrmStaff {
  id                String   @id @default(cuid())
  first_name        String
  last_name         String
  father_name       String?
  phone             String
  email             String   @unique
  address           String?  @db.Text
  educations        String?  @db.Text
  tazkira_no        String?
  position          String
  salary            Decimal  @db.Decimal(12, 2)
  guarantor_name    String?
  guarantor_phone   String?
  guarantor_license String?
  join_date         DateTime
  contract_period   String?
  user_id           String?  @unique
  status            String   @default("ACTIVE")
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // CRM Back-Relations
  assigned_leads  CrmLead[]
  managed_clients CrmClient[]

  // Project & Contract Back-Relations
  managed_projects  Project[]  @relation("ProjectManager")
  managed_contracts Contract[]

  // Task Back-Relations
  assigned_tasks Task[] @relation("AssignedTasks")
  created_tasks  Task[] @relation("CreatedTasks")

  // Finance Back-Relations
  received_incomes   FinanceIncome[]
  spent_expenses     FinanceExpense[]
  salaries           FinanceSalary[]  @relation("StaffSalaries")
  processed_salaries FinanceSalary[]  @relation("ProcessedSalaries")
  loans              FinanceLoan[]    @relation("StaffLoans")
  approved_loans     FinanceLoan[]    @relation("ApprovedLoans")

  // Core HRM & Auth Relations
  user            User?               @relation(fields: [user_id], references: [id], onDelete: SetNull)
  contracts       HrmStaffContract[]
  leaves          HrmStaffLeave[]     @relation("StaffLeaves")
  approved_leaves HrmStaffLeave[]     @relation("ApprovedLeaves")
  timesheets      HrmStaffTimesheet[]
  project_members ProjectMember[]
}

model HrmStaffContract {
  id               String    @id @default(cuid())
  staff_id         String
  contract_number  String    @unique
  contract_type_id String
  position_title   String
  base_salary      Decimal   @db.Decimal(12, 2)
  start_date       DateTime
  end_date         DateTime?
  document_url     String?   @db.Text
  status_id        String
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  // Relations
  staff         HrmStaff @relation(fields: [staff_id], references: [id], onDelete: Restrict)
  contract_type Option   @relation("ContractType", fields: [contract_type_id], references: [id])
  status        Option   @relation("ContractStatus", fields: [status_id], references: [id])

  @@index([staff_id, status_id])
}

model HrmStaffLeave {
  id             String   @id @default(cuid())
  staff_id       String
  leave_type_id  String
  start_date     DateTime
  end_date       DateTime
  total_days     Int
  reason         String?  @db.Text
  status_id      String
  approved_by_id String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // Relations
  staff       HrmStaff  @relation("StaffLeaves", fields: [staff_id], references: [id], onDelete: Cascade)
  approved_by HrmStaff? @relation("ApprovedLeaves", fields: [approved_by_id], references: [id], onDelete: SetNull)
  leave_type  Option    @relation("LeaveType", fields: [leave_type_id], references: [id])
  status      Option    @relation("LeaveStatus", fields: [status_id], references: [id])

  @@index([staff_id, start_date])
}

model HrmStaffTimesheet {
  id             String    @id @default(cuid())
  staff_id       String
  project_id     String?
  status         String
  date           DateTime  @db.Date
  check_in_time  DateTime?
  check_out_time DateTime?
  hours_worked   Decimal?  @db.Decimal(5, 2)
  notes          String?   @db.Text
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  // Relations
  staff   HrmStaff @relation(fields: [staff_id], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [project_id], references: [id], onDelete: SetNull)

  @@index([staff_id, date])
}

// CRM
model CrmLead {
  id              String   @id @default(cuid())
  title           String
  company_name    String?
  contact_name    String
  email           String
  phone           String?
  source_id       String
  status_id       String
  assigned_to_id  String?
  estimated_value Decimal? @db.Decimal(12, 2)
  notes           String?  @db.Text
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  source           Option     @relation("LeadSource", fields: [source_id], references: [id])
  status           Option     @relation("LeadStatus", fields: [status_id], references: [id])
  assigned_to      HrmStaff?  @relation(fields: [assigned_to_id], references: [id], onDelete: SetNull)
  converted_client CrmClient?
  contracts        Contract[]

  @@index([status_id, created_at])
}

model CrmClient {
  id                   String   @id @default(cuid())
  lead_id              String?  @unique
  company_name         String
  primary_contact_name String
  email                String   @unique
  phone                String?
  address              String?  @db.Text
  tax_id               String?
  account_manager_id   String?
  status               String   @default("ACTIVE")
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  // Relations
  lead            CrmLead?          @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  account_manager HrmStaff?         @relation(fields: [account_manager_id], references: [id], onDelete: SetNull)
  contracts       Contract[]
  projects        Project[]
  incomes         FinanceIncome[]
  invoices        ContractInvoice[]
}

model CrmVisitor {
  id           String   @id @default(uuid())
  full_name    String
  email        String?
  phone        String
  company_name String?
  purpose      String
  visited_at   DateTime @default(now())
  host_user_id String?
  notes        String?  @db.Text
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  host_user User? @relation(fields: [host_user_id], references: [id], onDelete: SetNull)

  @@index([visited_at])
  @@index([host_user_id])
}

// PROJECT
model Project {
  id                 String    @id @default(cuid())
  contract_id        String?
  client_id          String
  project_code       String    @unique
  title              String
  description        String?   @db.Text
  status_id          String
  priority_id        String
  project_area       String?
  project_sponsor    String?
  project_manager_id String?
  estimated_hours    Decimal?  @db.Decimal(8, 2)
  actual_hours       Decimal?  @default(0) @db.Decimal(8, 2)
  budget             Decimal   @db.Decimal(12, 2)
  start_date         DateTime
  end_date           DateTime
  actual_end_date    DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  // Relations
  contract        Contract?           @relation(fields: [contract_id], references: [id], onDelete: SetNull)
  client          CrmClient           @relation(fields: [client_id], references: [id], onDelete: Restrict)
  status          Option              @relation("ProjectStatus", fields: [status_id], references: [id])
  priority        Option              @relation("ProjectPriority", fields: [priority_id], references: [id])
  project_manager HrmStaff?           @relation("ProjectManager", fields: [project_manager_id], references: [id], onDelete: SetNull)
  members         ProjectMember[]
  tasks           Task[]
  timesheets      HrmStaffTimesheet[]
  incomes         FinanceIncome[]
  expenses        FinanceExpense[]

  @@index([client_id, status_id])
}

model ProjectMember {
  id          String   @id @default(cuid())
  project_id  String
  staff_id    String
  role        String?
  assigned_at DateTime @default(now())

  // Relations
  project Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  staff   HrmStaff @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  @@unique([project_id, staff_id])
}

// CONTRACT
model Contract {
  id                 String    @id @default(cuid())
  client_id          String
  lead_id            String?
  contract_number    String    @unique
  title              String
  status_id          String
  total_amount       Decimal   @db.Decimal(12, 2)
  contract_duration  String?
  contract_type_id   String
  country_id         String?
  percentage         Decimal?  @db.Decimal(5, 2)
  currency           String    @default("USD")
  exchange_rate      Decimal?  @db.Decimal(10, 4)
  amount_usd         Decimal?  @db.Decimal(12, 2)
  level_id           String?
  signed_date        DateTime?
  start_date         DateTime
  end_date           DateTime
  auto_renew         Boolean   @default(false)
  renewal_status     String    @default("ACTIVE") // ACTIVE, PENDING_RENEWAL, RENEWED, EXPIRED, CANCELLED
  document_url       String?   @db.Text
  account_manager_id String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  // Relations
  client          CrmClient              @relation(fields: [client_id], references: [id], onDelete: Restrict)
  lead            CrmLead?               @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  status          Option                 @relation("ContractStatus", fields: [status_id], references: [id])
  contract_type   Option                 @relation("ContractType", fields: [contract_type_id], references: [id])
  country         Option?                @relation("ContractCountry", fields: [country_id], references: [id], onDelete: SetNull)
  level           Option?                @relation("ContractLevel", fields: [level_id], references: [id], onDelete: SetNull)
  account_manager HrmStaff?              @relation(fields: [account_manager_id], references: [id], onDelete: SetNull)
  projects        Project[]
  invoices        ContractInvoice[]
  incomes         FinanceIncome[]
  notifications   ContractNotification[]

  @@index([client_id, status_id])
}

model ContractInvoice {
  id             String   @id @default(cuid())
  contract_id    String
  client_id      String
  invoice_number String   @unique
  amount         Decimal  @db.Decimal(12, 2)
  due_date       DateTime
  status_id      String
  issued_date    DateTime @default(now())
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // Relations
  contract Contract  @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  client   CrmClient @relation(fields: [client_id], references: [id], onDelete: Restrict)
  status   Option    @relation("InvoiceStatus", fields: [status_id], references: [id])

  @@index([contract_id, status_id])
}

model ContractNotification {
  id              String   @id @default(cuid())
  contract_id     String
  reminder_type   String // 30_DAY, 15_DAY, 3_DAY, EXPIRED
  sent_at         DateTime @default(now())
  recipient_email String
  status          String   @default("SENT") // SENT, FAILED

  // Relations
  contract Contract @relation(fields: [contract_id], references: [id], onDelete: Cascade)

  @@index([contract_id, reminder_type])
}

// TASK
model Task {
  id              String    @id @default(cuid())
  project_id      String
  title           String
  description     String?   @db.Text
  status_id       String
  priority_id     String
  assigned_to_id  String?
  created_by_id   String?
  estimated_hours Decimal?  @db.Decimal(6, 2)
  actual_hours    Decimal?  @default(0) @db.Decimal(6, 2)
  due_date        DateTime?
  completed_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  // Relations
  project     Project   @relation(fields: [project_id], references: [id], onDelete: Restrict)
  status      Option    @relation("TaskStatus", fields: [status_id], references: [id])
  priority    Option    @relation("TaskPriority", fields: [priority_id], references: [id])
  assigned_to HrmStaff? @relation("AssignedTasks", fields: [assigned_to_id], references: [id], onDelete: SetNull)
  created_by  HrmStaff? @relation("CreatedTasks", fields: [created_by_id], references: [id], onDelete: SetNull)

  @@index([project_id, status_id])
  @@index([assigned_to_id, status_id])
}

// FINANCE
model FinanceIncome {
  id             String    @id @default(cuid())
  client_id      String?
  contract_id    String?
  project_id     String?
  received_by_id String?
  status         String    @default("PENDING")
  name           String
  pay_details    String?   @db.Text
  income_type_id String
  total_amount   Decimal   @db.Decimal(12, 2)
  paid_amount    Decimal   @default(0) @db.Decimal(12, 2)
  remind_amount  Decimal   @default(0) @db.Decimal(12, 2)
  exchange_rate  Decimal?  @db.Decimal(10, 4)
  total_usd      Decimal?  @db.Decimal(12, 2)
  remind_date    DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  // Relations
  client      CrmClient? @relation(fields: [client_id], references: [id], onDelete: SetNull)
  contract    Contract?  @relation(fields: [contract_id], references: [id], onDelete: SetNull)
  project     Project?   @relation(fields: [project_id], references: [id], onDelete: SetNull)
  received_by HrmStaff?  @relation(fields: [received_by_id], references: [id], onDelete: SetNull)
  income_type Option     @relation("IncomeType", fields: [income_type_id], references: [id])

  @@index([created_at])
}

model FinanceExpense {
  id              String   @id @default(cuid())
  project_id      String?
  spent_by_id     String?
  receipt_url     String?  @db.Text
  expense_date    DateTime @db.Date
  details         String   @db.Text
  expense_type_id String
  quantity        Int      @default(1)
  unit_price      Decimal  @db.Decimal(12, 2)
  sub_total       Decimal  @db.Decimal(12, 2)
  exchange_rate   Decimal? @db.Decimal(10, 4)
  total_usd       Decimal? @db.Decimal(12, 2)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  project      Project?  @relation(fields: [project_id], references: [id], onDelete: SetNull)
  spent_by     HrmStaff? @relation(fields: [spent_by_id], references: [id], onDelete: SetNull)
  expense_type Option    @relation("ExpenseType", fields: [expense_type_id], references: [id])

  @@index([created_at])
}

model FinanceSalary {
  id                String    @id @default(cuid())
  timesheet_summary String?   @db.Text
  status            String    @default("DRAFT")
  staff_id          String
  timesheet_month   String // e.g., "2026-08"
  total_month_days  Int
  worked_days       Int
  off_days          Int       @default(0)
  base_salary       Decimal   @db.Decimal(12, 2)
  base_daily_rate   Decimal   @db.Decimal(12, 2)
  earned_salary     Decimal   @db.Decimal(12, 2)
  bonus_amount      Decimal   @default(0) @db.Decimal(12, 2)
  loan_deduction    Decimal   @default(0) @db.Decimal(12, 2)
  payable_amount    Decimal   @db.Decimal(12, 2)
  exchange_rate     Decimal?  @db.Decimal(10, 4)
  payable_usd       Decimal?  @db.Decimal(12, 2)
  loan_status       String?   @default("PENDING")
  payment_date      DateTime? @db.Date
  processed_by_id   String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  // Relations
  staff        HrmStaff  @relation("StaffSalaries", fields: [staff_id], references: [id], onDelete: Restrict)
  processed_by HrmStaff? @relation("ProcessedSalaries", fields: [processed_by_id], references: [id], onDelete: SetNull)

  @@unique([staff_id, timesheet_month])
}

model FinanceLoan {
  id                String   @id @default(cuid())
  staff_id          String
  loan_number       String   @unique
  total_amount      Decimal  @db.Decimal(12, 2)
  monthly_deduction Decimal  @db.Decimal(12, 2)
  repaid_amount     Decimal  @default(0) @db.Decimal(12, 2)
  remaining_balance Decimal  @db.Decimal(12, 2)
  status_id         String
  issue_date        DateTime @db.Date
  reason            String?  @db.Text
  approved_by_id    String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relations
  staff       HrmStaff  @relation("StaffLoans", fields: [staff_id], references: [id], onDelete: Restrict)
  approved_by HrmStaff? @relation("ApprovedLoans", fields: [approved_by_id], references: [id], onDelete: SetNull)
  status      Option    @relation("LoanStatus", fields: [status_id], references: [id])
}

model Inventory {
  id                String   @id @default(cuid())
  name              String
  category_id       String
  sku_code          String   @unique
  quantity_in_stock Int      @default(0)
  unit_price        Decimal  @db.Decimal(12, 2)
  status_id         String
  reorder_level     Int      @default(5)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relations
  category Option @relation("InventoryCategory", fields: [category_id], references: [id])
  status   Option @relation("InventoryStatus", fields: [status_id], references: [id])

  @@index([category_id, status_id])
}

// OPTION
model Option {
  id         String   @id @default(cuid())
  category   String // e.g., LEAD_STATUS, PROJECT_PRIORITY, EXPENSE_TYPE
  label      String
  value      String
  description String?  @db.Text
  color_code String?
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  is_default Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // HRM Relations
  contract_types    HrmStaffContract[] @relation("ContractType")
  contract_statuses HrmStaffContract[] @relation("ContractStatus")
  leave_types       HrmStaffLeave[]    @relation("LeaveType")
  leave_statuses    HrmStaffLeave[]    @relation("LeaveStatus")

  // CRM Relations
  lead_sources  CrmLead[] @relation("LeadSource")
  lead_statuses CrmLead[] @relation("LeadStatus")

  // Projects & Tasks Relations
  project_statuses   Project[] @relation("ProjectStatus")
  project_priorities Project[] @relation("ProjectPriority")
  task_statuses      Task[]    @relation("TaskStatus")
  task_priorities    Task[]    @relation("TaskPriority")

  // Contracts Relations
  contract_statuses_ref Contract[]        @relation("ContractStatus")
  contract_types_ref    Contract[]        @relation("ContractType")
  contract_countries    Contract[]        @relation("ContractCountry")
  contract_levels       Contract[]        @relation("ContractLevel")
  invoice_statuses      ContractInvoice[] @relation("InvoiceStatus")

  // Finance & Inventory Relations
  income_types         FinanceIncome[]  @relation("IncomeType")
  expense_types        FinanceExpense[] @relation("ExpenseType")
  loan_statuses        FinanceLoan[]    @relation("LoanStatus")
  inventory_categories Inventory[]      @relation("InventoryCategory")
  inventory_statuses   Inventory[]      @relation("InventoryStatus")

  @@unique([category, value])
  @@index([category])
}

// SETUP
enum SetupScope {
  GLOBAL
}

model Setup {
  id                String     @id @default(cuid())
  scope             SetupScope @unique @default(GLOBAL)
  app_name          String     @default("ERP System")
  company_name      String
  company_logo      String?    @db.Text
  currency_code     String     @default("AFN")
  currency_symbol   String     @default("؋")
  timezone          String     @default("Asia/Kabul")
  date_format       String     @default("YYYY-MM-DD")
  fiscal_year_start String     @default("01-01") // MM-DD format
  default_tax_rate  Decimal    @default(0.00) @db.Decimal(5, 2)
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt
}

model SystemSetting {
  id           String   @id @default("default")
  lightLogoUrl String?
  darkLogoUrl  String?
  faviconUrl   String?
  updatedAt    DateTime @updatedAt
}
